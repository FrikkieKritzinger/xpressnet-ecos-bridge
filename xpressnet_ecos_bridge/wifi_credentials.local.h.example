/*
 * WiFi Credentials - LOCAL TEMPLATE
 *
 * Copy this file to "wifi_credentials.local.h" (same directory) and fill in
 * your real values. That file is gitignored and never committed - config.h
 * includes it to pull in WIFI_SSID/WIFI_PASSWORD without putting real
 * credentials in source control.
 */

#ifndef WIFI_CREDENTIALS_LOCAL_H
#define WIFI_CREDENTIALS_LOCAL_H

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

#endif  // WIFI_CREDENTIALS_LOCAL_H
